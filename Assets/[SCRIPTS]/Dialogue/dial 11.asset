  lines:
  - leftSpeaker: 0
    speakerName: Admiral Obi
    text: 'We detected another mothership near this area !

'
  - leftSpeaker: 1
    speakerName: Glorp
    text: 'Good ! It will be a great opportunity to show you our new asset: Heal
