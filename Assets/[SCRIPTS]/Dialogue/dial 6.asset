  lines:
  - leftSpeaker: 0
    speakerName: FIcelle
    text: "We got you now! Berserker or not, you won\u2019t escape alive!\r\n\n\n"
  - leftSpeaker: 1
    speakerName: Glorp
    text: "Hmm\u2026 I gotta say, we put ourselves in quite a bad situation here.\r\n\n\n"
  - leftSpeaker: 1
